// ── [1] O PODER DO EXTEND ─────────────────────────────────────────
// combinado: campos + defaults + mut + metodos + mutualidade + generics
// + protocolos + primitivos, no mesmo programa

// ── 1. struct simples + extend com tudo ao mesmo tempo ────────────
struct Post {
  title: string
  mut likes: int

  mut func like(): int {
    self.likes = self.likes + 1
    return self.likes
  }
}

extend Post {
  slug: string = "sem-slug"             // com default: opcional
  mut tags: string? = null              // campo mut, tipo optional

  mut func setTags(v: string): string {
    self.tags = v
    return self.tags
  }

  func ref(): string {
    return "[post] " + self.slug.upper()
  }

  mut func bump(n: int): int {
    var i = 0
    while (i < n) {
      self.like()
      i = i + 1
    }
    return self.likes
  }
}

val p = Post { title: "ola", likes: 0 }
print(p.title)               // ola
print(p.likes)               // 0
print(p.slug)                // sem-slug
print(p.tags)                // null

print(p.like())              // 1
print(p.likes)               // 1

print(p.setTags("geral"))    // geral
print(p.tags)                // geral

print(p.bump(3))             // 4
print(p.likes)               // 4
print(p.ref())               // [post] SEM-SLUG

// literal nomeado com o campo-default sobrescrito
val p2 = Post { title: "dois", likes: 0, slug: "post-dois" }
print(p2.slug)               // post-dois
print(p2.ref())              // [post] POST-DOIS

// chamada com named args no construtor
val p3 = Post(title: "tres", likes: 5)
print(p3.slug)               // sem-slug
print(p3.likes)              // 5
print(p3)                    // Post { title: "tres", likes: 5, slug: "sem-slug", tags: null }

// ── 2. tres extends no mesmo tipo, cada um com seu campo ─────────
struct Cfg {
  host: string
}

extend Cfg {
  port: int = 8080

  func url(): string {
    return "http://" + self.host + ":" + self.port.toString()
  }
}

extend Cfg {
  secure: bool = true

  func surl(): string {
    if (self.secure) {
      return "https-" + self.host + ":" + self.port.toString()
    }
    return self.url()
  }
}

extend Cfg {
  mut retries: int = 3

  mut func degrade(): int {
    self.retries = self.retries - 1
    return self.retries
  }
}

val c = Cfg { host: "lo" }
print(c.port)                // 8080
print(c.secure)              // true
print(c.retries)             // 3
print(c.url())               // http://lo:8080
print(c.surl())              // https-lo:8080
print(c.degrade())           // 2
print(c.degrade())           // 1
print(c)                     // Cfg { host: "lo", port: 8080, secure: true, retries: 1 }

// ── 3. struct generico + extend com campo e metodo ───────────────
struct Cell<T> {
  mut value: T

  func peek(): T {
    return self.value
  }
}

extend Cell {
  mut reads: int = 0

  mut func tally(): T {
    self.reads = self.reads + 1
    return self.value
  }
}

val ci = Cell { value: 7 }
print(ci.peek())             // 7
print(ci.tally())            // 7
print(ci.reads)              // 1
print(ci.tally())            // 7
print(ci.reads)              // 2
print(ci)                    // Cell { value: 7, reads: 2 }

val cs = Cell { value: "s" }
print(cs.peek())             // s
print(cs.tally())            // s

// ── 4. protocolo + extend ────────────────────────────────────────
protocol Summary {
  func summarize(): string
}

struct Account implements Summary {
  owner: string
  balance: int

  func summarize(): string {
    return self.owner + " $" + self.balance.toString()
  }
}

extend Account {
  currency: string = "USD"

  mut func deposit(amount: int): Account {
    self.balance = self.balance + amount
    return self
  }

  func detail(): string {
    return self.summarize() + " (" + self.currency + ")"
  }
}

val acc = Account { owner: "ana", balance: 100 }
print(acc.summarize())       // ana $100
print(acc.detail())          // ana $100 (USD)

val moved: Summary = acc.deposit(50)
print(moved.summarize())     // ana $150
print(acc.balance)           // 150
print(acc.detail())          // ana $150 (USD)

// ── 5. mutualidade: metodo do struct chama extend e vice-versa ────
// (sem hoisting: quem e usado dentro precisa estar declarado antes)
struct Rect {
  w: int
  h: int
}

func perimeter(r: Rect): int {
  return r.extra() + r.border()
}

extend Rect {
  func border(): int {
    return 2 * (self.w + self.h)
  }

  func report(): string {
    return perimeter(self) + "/" + self.border().toString()
  }
}

extend Rect {
  func extra(): int {
    return self.w * self.h
  }
}

val r = Rect { w: 3, h: 4 }
print(r.border())            // 14
print(r.extra())             // 12
print(r.report())            // 26/14

// ── 6. primitivos: string, int, float, bool ───────────────────────
extend String {
  func shout(): string {
    return self.upper() + "!"
  }

  func repeat(times: int): string {
    var out = ""
    var i = 0
    while (i < times) {
      out = out + self
      i = i + 1
    }
    return out
  }
}

extend Integer {
  func sq(): int {
    return self * self
  }
}

extend Float {
  func whole(): int {
    return self.toInt()
  }
}

extend Boolean {
  func toggle(): bool {
    return !self
  }
}

val s = "hey"
print(s.shout())             // HEY!
print(s.upper().lower().shout())   // HEY!
print("ab".repeat(3))        // ababab
print(s.shout().repeat(2))   // HEY!HEY!

print(5.sq())                // 25
print((2 + 3).sq())          // 25
print(3.sq().sq())           // 81
print(2.7.whole())           // 2
print(true.toggle())         // false
print(false.toggle().toggle())  // false

// ── 7. struct method usando metodo de PRIMITIVO-extend ───────────
struct Speaker {
  name: string

  func announce(): string {
    return self.name.shout()
  }
}

val sp = Speaker { name: "jed" }
print(sp.announce())         // JED!

// ── 8. construtor custom + campos-default do extend ──────────────
struct Token {
  mut value: string

  init(raw: string) {
    self.value = raw.trim()
  }

  func size(): int {
    return self.value.length
  }
}

extend Token {
  hash: string = "auto"

  mut func rehash(v: string): string {
    self.hash = v
    return self.hash
  }

  func info(): string {
    return self.value + "#" + self.hash
  }
}

val t = Token("  hello  ")
print(t.value)               // hello
print(t.hash)                // auto
print(t.info())              // hello#auto

val t2 = Token("  hello  ", "z")
print(t2.info())             // hello#z
print(t2.rehash("w"))        // w
print(t2.size())             // 5
print(t2)                    // Token { hash: "w", value: "hello" }

// resultado inline de construtor + metodo do extend
print(Token("inline").info())   // inline#auto

// ── 9. tudo junto no encerramento ─────────────────────────────────
print(s.shout().repeat(2).length)       // 8
print(p.ref().lower())                  // [post] sem-slug
print(4.sq().toString().shout())        // 16!
print("mix" + (9.sq()).toString())      // mix81
print(true.toggle().toString().upper())    // FALSE