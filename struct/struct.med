// === Test: Struct Fields ===

// 1. Básico: mut + type + default
struct Config {
    mut name: string
    mut age: int
    pi: float = 3.14
}

// 2. Arrays nos campos
struct WithArray {
    ids: int[]
    matrix: int[][]
    names: string[]
    nested: Array<int>
}

// 3. Union types
struct WithUnion {
    result: int | string
    nullable: string | null
    complex: int | string | bool
}

// 4. Nullable fields
struct WithNullable {
    email: string?
    age: int?
    score: float?
    flag: bool?
}

// 5. Todos os tipos primitivos
struct AllPrimitives {
    a: int
    b: float
    c: string
    d: bool
}

// 6. Campos duplicados (deve detectar erro)
struct Duplicate {
    name: string
//    name: int
}

// 7. Propriedades com default value
struct WithDefaults {
    mut id: string = "abcd1fg2h123"
    name: string = "Jonny"
    count: int = 42
    ratio: float = 3.14
    active: bool = true
    tags: string[] = ["a", "b"]
}

// 8. Typealias + struct
typealias UUID = string
typealias Score = int | float

struct User {
    mut id: UUID = "default-id"
    name: string
    score: Score
}

// 9. Mixed: tudo junto
struct FullFeatured {
    mut id: string = "default"
    name: string
    tags: string[]
    metadata: string?
    status: int | string
    score: float = 0.0
    active: bool = true
}

// 10. Struct vazia
struct Empty {
}

// 11. Campo com nome de keyword
struct WithKeywordField {
    val: int
    if: string
    else: bool
}

struct User {
    name: string
    age: int
}

struct Point {
    x: float
    y: float
}

func greet(u: User) {
    val msg = u.name
}

func isAdult(u: User): bool {
    return u.age >= 18
}

func moveX(p: Point, dx: float): Point {
    return Point { x: p.x + dx, y: p.y }
}

val alice = User { name: "Alice", age: 30 }

greet(alice)

val adult = isAdult(alice)

val p = Point { x: 1.0, y: 2.0 }
val p2 = moveX(p, 5.0)

greet(User { name: "Bob", age: 25 })

val result = isAdult(User { name: "Charlie", age: 15 })
