// ═════════════════════════════════════════════════════════════
// struct-constructors-auto.med — Auto-init (seções 4.1 ~ 4.3)
//
// Cobre:
// 4.1 argumentos nomeados, ordem livre
// 4.2 validação: duplicata → desconhecido → ausente → tipo
// 4.3 aliases de tipo como construtor
// ═════════════════════════════════════════════════════════════


// ───────────────────────────────────────────────────────────────
// 1. Caminho feliz — campos obrigatórios, ordem canônica
// ───────────────────────────────────────────────────────────────

struct Point {
  x: float
  y: float
}

val p1 = Point(x: 1.0, y: 2.0)
val p2 = Point(y: 2.0, x: 1.0) // ordem invertida — deve funcionar

val check_x: float = p1.x // 1.0
val check_y: float = p1.y // 2.0


// ───────────────────────────────────────────────────────────────
// 2. Campos com padrão — orientação no construtor
// ───────────────────────────────────────────────────────────────

struct Config {
  host: string
  port: int = 8080
  timeout: int = 30
  debug: bool = false
}

val c1 = Config(host: "localhost") // todos os padrões
val c2 = Config(host: "prod.io", port: 443) // timeout e debug com default
val c3 = Config(host: "dev.io", debug: true) // timeoute porta e padrão
val c4 = Config(host: "x", port: 80, timeout: 5, debug: true) // nenhum padrão usado

val c1_port: int = c1.port // 8080
val c2_port: int = c2.port // 443
val c3_debug: bool = c3.debug // true
val c4_timeout: int = c4.timeout // 5


// ───────────────────────────────────────────────────────────────
// 3. Todos os campos com padrão — construtor vazio válido
// ───────────────────────────────────────────────────────────────

struct Defaults {
  a: int = 0
  b: string = ""
  c: bool = false
}

val d1 = Defaults()
val d2 = Defaults(a: 42)
val d3 = Defaults(a: 1, b: "oi", c: true)

val d1_a: int = d1.a // 0
val d2_a: int = d2.a // 42
val d3_b: string = d3.b // "oi"


// ───────────────────────────────────────────────────────────────
// 4. Estruturas genéricas — auto-init com tipo anotado
// ───────────────────────────────────────────────────────────────

struct Box<T> {
  value: T
}

val bi = Box<int>(value: 10)
val bs = Box<string>(value: "hello")
val bf = Box<float>(value: 3.14)

val bi_v: int = bi.value // 10
val bs_v: string = bs.value // "hello"


// ───────────────────────────────────────────────────────────────
// 5. Struct com campos de struct — composição
// ───────────────────────────────────────────────────────────────

struct Vec2 {
  x: float
  y: float
}

struct Line {
  start: Vec2
  end: Vec2
}

val origin = Vec2(x: 0.0, y: 0.0)
val target = Vec2(x: 3.0, y: 4.0)
val line = Line(start: origin, end: target)

val line_x: float = line.start.x // 0.0
val line_y: float = line.end.y // 4.0


// ───────────────────────────────────────────────────────────────
// 6. ❌ Argumento posicional — sempre erro
// ───────────────────────────────────────────────────────────────

// val bad = Point(1.0, 2.0)
// erro: argumentos posicionais não são permitidos no construtor da struct 'Point'


// ───────────────────────────────────────────────────────────────
// 7. ❌ Duplicata de argumento
// ───────────────────────────────────────────────────────────────

// val bad = Point(x: 1.0, x: 2.0, y: 3.0)
// erro: argumento duplicado 'x' na chamada para 'Point'

// val bad2 = Config(host: "a", port: 80, host: "b")
// erro: argumento duplicado 'host' na chamada para 'Config'


// ───────────────────────────────────────────────────────────────
// 8. ❌ Argumento desconhecido
// ───────────────────────────────────────────────────────────────

// val bad = Point(x: 1.0, y: 2.0, z: 3.0)
// erro: argumento desconhecido 'z' na chamada para 'Point'

// val bad2 = Config(host: "x", retries: 3)
// erro: argumento desconhecido 'retries' na chamada para 'Config'


// ───────────────────────────────────────────────────────────────
// 9. ❌ Argumento ausente (campo obrigatório)
// ───────────────────────────────────────────────────────────────

// val bad = Point(x: 1.0)
// erro: argumento 'y' ausente na chamada para 'Point'

// val bad2 = Config()
// erro: argumento 'host' ausente na chamada para 'Config'


// ───────────────────────────────────────────────────────────────
// 10. ❌ Tipo errado no argumento
// ───────────────────────────────────────────────────────────────

// val bad = Point(x: "one", y: 2.0)
// erro: não é possível atribuir 'string' ao campo 'x' do tipo 'float'

// val bad2 = Config(host: "x", port: "8080")
// erro: não é possível atribuir 'string' ao campo 'port' do tipo 'int'


// ───────────────────────────────────────────────────────────────
// 11. ❌ Ordem de erros — duplicata detectada antes de desconhecida
// ───────────────────────────────────────────────────────────────

// val bad = Point(x: 1.0, x: 2.0, z: 3.0)
// erro: argumento duplicado 'x' na chamada para 'Point'
// (z não é reportado — para no primeiro erro)


// ───────────────────────────────────────────────────────────────
// 12. Type alias — construtor via alias simples
// ───────────────────────────────────────────────────────────────

typealias Origin = Point

val o1 = Origin(x: 0.0, y: 0.0)
val o_x: float = o1.x // 0.0


// ───────────────────────────────────────────────────────────────
// 13. Type alias — construtor via alias genérico
// ───────────────────────────────────────────────────────────────

typealias IntBox = Box<int>
typealias StringBox = Box<string>

val ib = IntBox(value: 99)
val sb = StringBox(value: "world")

val ib_v: int = ib.value // 99
val sb_v: string = sb.value // "world"


// ───────────────────────────────────────────────────────────────
// 14. ❌ Type alias — tipo errado preserva o nome do alias na mensagem
// ───────────────────────────────────────────────────────────────

// val bad = IntBox(value: "ninety")
// erro: não é possível atribuir 'string' ao campo 'value' do tipo 'int' em 'IntBox'
// (mensagem usa 'IntBox', não 'Box<int>')


// ───────────────────────────────────────────────────────────────
// 15. ❌ Type alias — argumento ausente preserva nome do alias
// ───────────────────────────────────────────────────────────────

// val bad = IntBox()
// erro: argumento 'value' ausente na chamada para 'IntBox'
