// ========================================
// Type Annotation Tests
// ========================================

// ----------------------------------------
// Primitive Types
// ----------------------------------------
var a: int
var b: float
var c: string
var d: bool
var e: void
var f: null
var g: any
var h: unknown

// ----------------------------------------
// Named Types (custom)
// ----------------------------------------
var user: User
var product: Product
var order: Order
var item: Item
var data: Data

// ----------------------------------------
// Generics - Single Type Parameter
// ----------------------------------------
var items: Array<int>
var names: List<string>
var flags: Set<bool>
var promise: Promise<User>

// ----------------------------------------
// Generics - Multiple Type Parameters
// ----------------------------------------
var pairs: Map<string, int>
var map: Map<User, Product>

// ----------------------------------------
// Generics - Nested
// ----------------------------------------
var matrix: Array<Array<float>>
var nested: List<List<User>>
var deep: Map<string, Array<User>>

// ----------------------------------------
// Generics - Multiple Arguments
// ----------------------------------------
var multi: Map<string, int, bool>

// ----------------------------------------
// Combined Examples
var users: List<User>
var cache: Map<string, Array<Product>>
var result: Promise<Result<User>>

// ========================================
// Function Types (NEW!)
// ========================================

// Basic function types
var fn1: (int) => string
var fn2: (int, string) => bool
var fn3: () => void
var fn4: (int[]) => string[]
var fn5: (User) => Product

// Function with union parameter
var fnUnion: (int | string) => bool

// Function returning function
var fnNested: (int) => (string) => bool

// Array of functions
var fnArr1: ((int) => int)[]
var fnArr2: ((string) => bool)[]

// ========================================
// Grouping Types (NEW!)
// ========================================

var grp1: (int)
var grp2: (int | string)
var grp3: ((int) => int)

// Grouping with array
var grpArr1: (int)[]
var grpArr2: (int | string)[]
var grpArr3: ((int) => int)[]

// Grouping with union
var grpUnion: (int | string) | null

// ========================================
// Nullable Types (NEW!)
// ========================================

var n1: int?
var n2: string?
var n3: User?
var n4: (int) => string?

// ========================================
// Array Types with Nullable
// ========================================

// Array of nullable element: int?[] means "array where each element can be null"
var an1: int?[]
var an2: string?[]
var an3: bool?[]
var an4: User?[]

// Nullable array: int[]? means "the array itself can be null"
var an5: int[]?
var an6: string[]?
var an7: bool[]?
var an8: User[][]?

// Combination: nullable inside array, then array itself nullable
var an9: int?[]?
var an10: string?[]?
var an11: User?[]?

// Multi-dimensional arrays with nullable
var an12: int[][]
var an13: int[][]?
var an14: int?[][]
var an15: int?[][]?
var an16: string[][]?
var an17: User[][]?

// ========================================
// Function Types with Nullable Arrays
// ========================================

var fa1: () => int?[]
var fa2: () => int[]?
var fa3: (int?) => string
var fa4: (int[]?) => string
var fa5: (int?[]) => string

// ========================================
// Generics with Nullable Arrays
// ========================================

var ga1: Array<int?>[]
var ga2: Array<int[]>?[]
var ga3: Array<int?[]>?[]
var ga4: Map<string?, int>[]
var ga5: Map<string, int?>[]

// ========================================
// Tuple Types with Nullable
// ========================================

var ta1: [int, string][]
var ta2: [int?, string][]
var ta3: [int, string?][]
var ta4: [int?, string?][]

// ========================================
// Union Types with Nullable Arrays
// ========================================

var ua1: int | string?[]
var ua2: int[] | string[]
var ua3: User? | null
var ua4: int? | null
var ua5: [int, string?][]
var ua6: (int | string?)[]

// ========================================
// Nullable with Generics (NEW!)
// ========================================

// Nullable type argument inside generic
var ng1: Map<string?, int>
var ng2: Map<string?, int[]>
var ng3: Map<string, int?>
var ng4: List<int?>?
var ng5: Array<int?>
var ng6: List<User?>
var ng7: Promise<User?>

// Complex nullable generics
var ng8: Map<string?, int?>
var ng9: Map<string?, int[]?>
var ng10: Map<string?, () => int?>
var ng11: (List<int?>) => Map<string, int?>

// Nested nullable generics
var ng12: Map<string, List<int?>>
var ng13: List<Array<int?>>
var ng14: Array<List<int?>?>
var ng15: Map<string, Map<int?, string>>

// Nullable inner generic type
var ng16: [Map<string?, int>, List<User?>]