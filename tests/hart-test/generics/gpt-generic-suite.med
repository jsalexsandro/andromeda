// ============================================================
// 1. DEEP ARRAY INFERENCE
// ============================================================

func deep<T>(x: T[][][][]): T {
  return x[0][0][0][0]
}

val a1: int = deep([[[[1]]]])
val a2: string = deep([[[["hello"]]]])



// ============================================================
// 2. NULLABLE + ARRAY + GENERIC
// ============================================================

func nullableDeep<T>(x: T[]?): T[]? {
  return x
}

val b1: int[]? = nullableDeep([1, 2, 3])
val b2: int[]? = nullableDeep(null)


// EXPECTED: GENERIC_INFERENCE_FAILED
// val b3 = nullableDeep(null)



// ============================================================
// 3. FUNCTION TYPE INFERENCE
// ============================================================

func apply<T>(x: T, fn: (T) => T): T {
  return fn(x)
}

val c1: int = apply(10, (n: int) => n + 1)
val c2: string = apply("a", (s: string) => s + "b")



// ============================================================
// 4. CONTEXTUAL ARROW INFERENCE
// ============================================================

func process<T>(fn: () => T): T {
  return fn()
}

val d1: int = process(() => 42)
val d2: string = process(() => "hello")



// ============================================================
// 5. MULTI GENERIC INFERENCE
// ============================================================

func pair<A, B>(a: A, b: B): B {
  return b
}

val e1: string = pair(1, "hello")
val e2: bool = pair("x", true)
val e3: int[] = pair(false, [1, 2, 3])



// ============================================================
// 6. GENERIC RETURNING GENERIC
// ============================================================

func box<T>(x: T): T[] {
  return [x]
}

val f1: int[] = box(42)
val f2: string[] = box("hello")



// ============================================================
// 7. HIGHER ORDER GENERICS
// ============================================================

func compose<A, B, C>(
  f: (B) => C,
  g: (A) => B,
  x: A
): C {
  return f(g(x))
}

val g1: int = compose(
  (n: int) => n + 1,
  (s: string) => 42,
  "hello"
)



// ============================================================
// 8. GENERIC WITH FUNCTION ARRAY
// ============================================================

func execute<T>(fns: (() => T)[]): T {
  return fns[0]()
}

val h1: int = execute([
  (): int => 1,
  (): int => 2
])

val h2: string = execute([
  (): string => "a",
  (): string => "b"
])



// ============================================================
// 9. NESTED GENERIC INFERENCE
// ============================================================

func nested<T>(x: T[][]?): T[][]? {
  return x
}

val i1: int[][]? = nested([[1], [2]])
val i2: string[][]? = nested([["a"], ["b"]])



// ============================================================
// 10. UNION GENERICS
// ============================================================

func choose<T>(a: T, b: T): T {
  return a
}

val j1: int = choose(1, 2)
val j2: string = choose("a", "b")

