// ============================================================
// 11. RECURSIVE GENERIC CALLS
// ============================================================

func recursive<T>(x: T): T {
  return recursive<T>(x)
}

val k1: int = recursive<int>(1)



// ============================================================
// 12. FUNCTION TYPE STRUCTURAL MATCH
// ============================================================

func call<T>(fn: (T) => T, value: T): T {
  return fn(value)
}

val l1: int = call(
  (n: int) => n + 1,
  10
)

val l2: string = call(
  (s: string) => s + "!",
  "hello"
)



// ============================================================
// 13. GENERIC + MULTIDIM ARRAY
// ============================================================

func matrix<T>(x: T[][][]): T[][][] {
  return x
}

val m1: int[][][] = matrix([
  [[1], [2]],
  [[3], [4]]
])



// ============================================================
// 14. GENERIC + TYPEALIAS
// ============================================================

typealias UserId = int

func identity<T>(x: T): T {
  return x
}

val n1: UserId = identity<UserId>(1)



