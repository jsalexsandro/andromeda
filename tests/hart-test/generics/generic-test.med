// EXPECTED: TYPE_MISMATCH
// val n2: string = first([1, 2, 3])

// ============================================================
// BLOCO 16 — NON GENERIC CALL
// ============================================================

func normal(x: int): int {
  return x
}

// EXPECTED: NOT_GENERIC
// val o1 = normal<int>(42)

// ============================================================
// BLOCO 17 — DUPLICATE TYPE PARAMS
// ============================================================

// EXPECTED: ALREADY_DECLARED
// func bad<T, T>(x: T): T {
//   return x
// }

// ============================================================
// BLOCO 18 — GENERIC COM INDEXAÇÃO
// ============================================================

func index<T>(arr: T[], i: int): T {
  return arr[i]
}

val p1: int = index<int>([1, 2, 3], 0)
val p2: string = index<string>(["a", "b"], 1)

// ============================================================
// BLOCO 19 — GENERIC COM ARRAY NULLABLE
// ============================================================

func nullableArray<T>(arr: T[]?): T[]? {
  return arr
}

val q1: int[]? = nullableArray<int>([1, 2])
val q2: int[]? = nullableArray<int>(null)

// ============================================================
// BLOCO 20 — TESTE PESADO DE INFERENCE
// ============================================================

func choose<T>(a: T, b: T): T {
  return a
}

val r1 = choose(1, 2)
val r2 = choose("a", "b")
val r3 = choose([1, 2], [3, 4])

// EXPECTED: TYPE_MISMATCH
// val r4 = choose(1, "hello")