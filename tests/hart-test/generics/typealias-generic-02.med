// ============================================================
// TYPEALIAS GENERICS — COMPREHENSIVE TEST SUITE
// User's original file translated to English keywords
// ============================================================


// ============================================================
// GROUP 1 — IDENTITY ALIAS (Box<T> = T)
// ============================================================

typealias Box<T> = T

val g1_int: Box<int> = 42
val g1_float: Box<float> = 3.14
val g1_string: Box<string> = "hello"
val g1_bool: Box<bool> = true
val g1_null: Box<null> = null

func g1_add(a: Box<int>, b: Box<int>): Box<int> {
  return a + b
}
val g1_res: Box<int> = g1_add(10, 20)


// ============================================================
// GROUP 2 — NULLABLE ALIAS (Maybe<T> = T?)
// ============================================================

typealias Maybe<T> = T?

val g2_some: Maybe<int> = 42
val g2_none: Maybe<int> = null
val g2_str: Maybe<string> = "world"
val g2_strnil: Maybe<string> = null
val g2_bool: Maybe<bool> = true
val g2_boolnil: Maybe<bool> = null

func g2_unwrap(x: Maybe<int>): int {
  if val v = x {
    return v
  }
  return 0
}
val g2_r1: int = g2_unwrap(42)
val g2_r2: int = g2_unwrap(null)


// ============================================================
// GROUP 3 — ARRAY ALIAS (List<T> = T[])
// ============================================================

typealias List<T> = T[]

val g3_ints: List<int> = [1, 2, 3]
val g3_strs: List<string> = ["a", "b", "c"]
val g3_floats: List<float> = [1.0, 2.5, 3.14]
val g3_bools: List<bool> = [true, false, true]
val g3_empty: List<int> = []

var g3_a: List<int> = [1, 2]
var g3_b: List<int> = [3, 4]
val g3_merged: List<int> = [...g3_a, ...g3_b]

func g3_first<T>(arr: List<T>): T {
  return arr[0]
}
val g3_r1: int = g3_first<int>([10, 20])
val g3_r2: string = g3_first<string>(["x", "y"])


// ============================================================
// GROUP 4 — NULLABLE ARRAY ALIAS (NullableList<T> = T[] | null)
// ============================================================

typealias NullableList<T> = T[] | null

val g4_some: NullableList<int> = [1, 2, 3]
val g4_none: NullableList<int> = null
val g4_strs: NullableList<string> = ["hello"]
val g4_nil2: NullableList<string> = null

func g4_safe_first<T>(arr: NullableList<T>, fallback: T): T {
  if val xs = arr {
    return xs[0]
  }
  return fallback
}
val g4_r1: int = g4_safe_first<int>(null, -1)
val g4_r2: int = g4_safe_first<int>([99, 0], -1)
val g4_r3: string = g4_safe_first<string>(null, "default")


// ============================================================
// GROUP 5 — ARRAY OF NULLABLE ELEMENTS (Items<T> = T?[])
// ============================================================

typealias Items<T> = T?[]

val g5_mixed: Items<int> = [1, null, 3, null]
val g5_strs: Items<string> = ["a", null, "b"]
val g5_bools: Items<bool> = [null, true, null, false]


// ============================================================
// GROUP 6 — MATRIX ALIAS (Matrix<T> = T[][])
// ============================================================

typealias Matrix<T> = T[][]

val g6_ints: Matrix<int> = [
  [1, 2, 3],
  [4, 5, 6],
  [7, 8, 9]
]
val g6_strs: Matrix<string> = [
  ["a", "b"],
  ["c", "d"]
]
val g6_empty: Matrix<float> = []

func g6_row<T>(m: Matrix<T>, i: int): T[] {
  return m[i]
}
val g6_r1: int[] = g6_row<int>(g6_ints, 0)


// ============================================================
// GROUP 7 — FUNCTION ALIAS (Fn<T> = (T) => T)
// ============================================================

typealias Fn<T> = (T) => T

val g7_int_fn: Fn<int> = (x: int): int => x + 1
val g7_str_fn: Fn<string> = (s: string): string => s
val g7_bool_fn: Fn<bool> = (b: bool): bool => b

func g7_apply<T>(x: T, fn: Fn<T>): T {
  return fn(x)
}
val g7_r1: int = g7_apply<int>(10, (n: int): int => n * 2)
val g7_r2: string = g7_apply<string>("hi", (s: string): string => s)


// ============================================================
// GROUP 8 — TRANSFORM ALIAS (Transform<A, B> = (A) => B)
// ============================================================

typealias Transform<A, B> = (A) => B

val g8_int_to_str: Transform<int, string> = (n: int): string => "ok"
val g8_str_to_int: Transform<string, int> = (s: string): int => 0
val g8_int_to_bool: Transform<int, bool> = (n: int): bool => true

func g8_map<A, B>(x: A, fn: Transform<A, B>): B {
  return fn(x)
}
val g8_r1: string = g8_map<int, string>(42, (n: int): string => "ok")
val g8_r2: bool = g8_map<int, bool>(0, (n: int): bool => false)


// ============================================================
// GROUP 9 — PAIR ALIAS (Pair<A, B> projects second type)
// ============================================================

typealias Pair<A, B> = B

val g9_r1: Pair<int, string> = "hello"
val g9_r2: Pair<bool, int> = 42
val g9_r3: Pair<string, bool> = true
val g9_r4: Pair<float, null> = null


