}


// ============================================================
// GROUP 26 — ALIAS OF BUILTIN Optional<T>
// ============================================================

typealias SafeInt = Optional<int>

val g26_r1: SafeInt = 42
val g26_r2: SafeInt = null

func g26_safe(x: SafeInt): int {
  if val v = x {
    return v
  }
  return -1
}
val g26_r3: int = g26_safe(42)
val g26_r4: int = g26_safe(null)


// ============================================================
// GROUP 27 — ALIAS FOR CALLBACK RETURNING NULLABLE
// ============================================================

typealias MaybeMapper<T, U> = (T) => U?

val g27_fn: MaybeMapper<int, string> = (n: int): string? => "ok"
val g27_nil: MaybeMapper<int, string> = (n: int): string? => null

func g27_run<T, U>(x: T, fn: MaybeMapper<T, U>, fallback: U): U {
  if val r = fn(x) {
    return r
  }
  return fallback
}
val g27_r1: string = g27_run<int, string>(1, g27_fn, "default")
val g27_r2: string = g27_run<int, string>(1, g27_nil, "default")


// ============================================================
// GROUP 28 — STRESS COMBINATION
// Alias of alias of alias with nullable array + function.
// ============================================================

typealias Raw<T> = T
typealias RawList<T> = Raw<T>[]
typealias RawOpt<T> = Raw<T>?
typealias RawFn<T> = (Raw<T>) => Raw<T>
typealias RawOptList<T> = RawList<T>?

val g28_raw: Raw<int> = 7
val g28_list: RawList<int> = [1, 2, 3]
val g28_opt: RawOpt<string> = null
val g28_fn: RawFn<int> = (x: int): int => x
val g28_optlist: RawOptList<bool> = null
val g28_optlist2: RawOptList<int> = [10, 20]

func g28_process<T>(
  list: RawOptList<T>,
  transform: RawFn<T>,
  fallback: Raw<T>
): RawOpt<T> {
  if val xs = list {
    return transform(xs[0])
  }
  return fallback
}

val g28_r1: RawOpt<int> = g28_process<int>([1, 2], (n: int): int => n + 1, 0)
val g28_r2: RawOpt<int> = g28_process<int>(null, (n: int): int => n, -1)


// ============================================================
// GROUP 30 — BIDIRECTIONAL INFERENCE THROUGH ALIAS
// ============================================================

typealias AResult<T> = T?

func g30_maybe<T>(x: T?): AResult<T> {
  return x
}

val g30_r1: AResult<int> = g30_maybe(42)
val g30_r2: AResult<int> = g30_maybe(null)
val g30_r3: AResult<string> = g30_maybe("hi")
val g30_r4: AResult<string> = g30_maybe(null)
