// ============================================================
// GROUP 12 — NESTED GENERIC ALIAS (Outer<T> wraps Inner<T>)
// ============================================================

typealias Inner<T> = T[]
typealias Outer<T> = Inner<T>[]

val g12_r1: Outer<int> = [
  [1, 2],
  [3, 4]
]
val g12_r2: Outer<string> = [
  ["a", "b"],
  ["c"]
]


// ============================================================
// GROUP 13 — GENERIC ALIAS IN GENERIC FUNCTION
// ============================================================

typealias Container<T> = T[]

func g13_clone<T>(c: Container<T>): Container<T> {
  return [...c]
}
val g13_r1: Container<int> = g13_clone<int>([1, 2, 3])
val g13_r2: Container<string> = g13_clone<string>(["x"])

func g13_push<T>(c: Container<T>, item: T): Container<T> {
  return [...c, item]
}
val g13_r3: Container<int> = g13_push<int>([1, 2], 3)


// ============================================================
// GROUP 14 — GENERIC ALIAS + OPTIONAL BINDING (if val)
// ============================================================

typealias Opt<T> = T?

func g14_unwrap<T>(x: Opt<T>, fallback: T): T {
  if val v = x {
    return v
  }
  return fallback
}

val g14_r1: int = g14_unwrap<int>(42, 0)
val g14_r2: int = g14_unwrap<int>(null, -1)
val g14_r3: string = g14_unwrap<string>("hello", "fallback")
val g14_r4: string = g14_unwrap<string>(null, "fallback")


// ============================================================
// GROUP 15 — GENERIC ALIAS + ARROW FUNCTION
// ============================================================

typealias Producer<T> = () => T

val g15_int_prod: Producer<int> = (): int => 42
val g15_str_prod: Producer<string> = (): string => "hi"
val g15_null_prod: Producer<null> = (): null => null

func g15_run<T>(produce: Producer<T>): T {
  return produce()
}
val g15_r1: int = g15_run<int>((): int => 99)
val g15_r2: string = g15_run<string>((): string => "ok")

val g15_wrap = <T>(x: T): Container<T> => [x]
val g15_r3: Container<int> = g15_wrap<int>(7)
val g15_r4: Container<string> = g15_wrap<string>("z")


// ============================================================
// GROUP 16 — HIGHER ORDER ALIAS (Mapper<T, U>)
// ============================================================

typealias Mapper<T, U> = (T) => U

func g16_map<T, U>(arr: T[], fn: Mapper<T, U>): U[] {
  return [fn(arr[0])]
}
val g16_r1: string[] = g16_map<int, string>([1, 2, 3], (n: int): string => "ok")
val g16_r2: bool[] = g16_map<string, bool>(["a"], (s: string): bool => true)


// ============================================================
// GROUP 17 — NULLABLE FUNCTION ALIAS (MaybeFn<T>)
// ============================================================

typealias MaybeFn<T> = ((T) => T)?

var g17_some: MaybeFn<int> = (x: int): int => x + 1
var g17_none: MaybeFn<int> = null
var g17_str: MaybeFn<string> = (s: string): string => s
var g17_nil2: MaybeFn<string> = null

func g17_call<T>(fn: MaybeFn<T>, x: T, fallback: T): T {
  if val f = fn {
    return f(x)
  }
  return fallback
}
val g17_r1: int = g17_call<int>(g17_some, 10, 0)
val g17_r2: int = g17_call<int>(null, 10, 0)
val g17_r3: string = g17_call<string>(null, "x", "fallback")


