// ============================================================
// GROUP 20 — ALIAS IN GENERIC ARROW FUNCTION
// ============================================================

typealias Wrap<T> = T[]

val g20_wrap = <T>(x: T): Wrap<T> => [x]
val g20_unwrap = <T>(xs: Wrap<T>): T => xs[0]

val g20_r1: Wrap<int> = g20_wrap<int>(5)
val g20_r2: Wrap<string> = g20_wrap<string>("hi")
val g20_r3: int = g20_unwrap<int>([42])
val g20_r4: string = g20_unwrap<string>(["ok"])


// ============================================================
// GROUP 21 — ALIASES USED AS CALLBACK CONSTRAINTS
// ============================================================

typealias Predicate<T> = (T) => bool

func g21_filter_first<T>(arr: T[], pred: Predicate<T>): T? {
  if (len(arr) == 0) {
    return null
  }

  val x = arr[0]

  if (pred(x)) {
    return x
  }

  return null
}

val g21_pred_int: Predicate<int> = (n: int): bool => n > 0
val g21_pred_str: Predicate<string> = (s: string): bool => true

val g21_r1: int? = g21_filter_first<int>([1, 2, 3], g21_pred_int)
val g21_r2: string? = g21_filter_first<string>(["x"], g21_pred_str)


// ============================================================
// GROUP 22 — ALIAS NORMALIZATION (alias resolves to builtin)
// ============================================================

typealias Nums = int[]

func g22_sum(arr: int[]): int {
  return arr[0]
}

val g22_nums: Nums = [10, 20, 30]
val g22_r1: int = g22_sum(g22_nums)


// ============================================================
// GROUP 23 — MULTI-PARAM ALIAS IN MULTI-PARAM GENERIC FUNCTION
// ============================================================

typealias Zipper<A, B> = (A, B) => B

func g23_zip<A, B>(a: A, b: B, fn: Zipper<A, B>): B {
  return fn(a, b)
}

val g23_r1: string = g23_zip<int, string>(1, "hi", (a: int, b: string): string => b)
val g23_r2: int = g23_zip<bool, int>(true, 42, (a: bool, b: int): int => b)


// ============================================================
// GROUP 24 — SELF-REFERENTIAL FORM (different param)
