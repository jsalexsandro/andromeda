// ════════════════════════════════════════════════════════════════
// named-args-02.med — Named Arguments: struct methods, chaining,
//                     nested calls, multiple orders, edge cases
// ════════════════════════════════════════════════════════════════


// ───────────────────────────────────────────────────────────────
// 1. Named args com struct methods
// ───────────────────────────────────────────────────────────────

struct Vec2 {
  x: float
  y: float

  func dot(other: Vec2): float {
    return self.x * other.x + self.y * other.y
  }
}

val v = Vec2 { x: 1.0, y: 2.0 }
val w = Vec2 { x: 3.0, y: 4.0 }
val d: float = v.dot(other: w)

// ───────────────────────────────────────────────────────────────
// 2. Named args com múltiplos parâmetros do mesmo tipo
// ───────────────────────────────────────────────────────────────

func compare(a: int, b: int): bool {
  return a == b
}

val eq: bool = compare(a: 10, b: 10)
val ne: bool = compare(b: 5, a: 3)

// ───────────────────────────────────────────────────────────────
// 3. Method chaining com named args
// ───────────────────────────────────────────────────────────────

struct Chain {
  func first(x: int): Chain {
    return self
  }
  func second(y: string): Chain {
    return self
  }
}

val ch = Chain {}
  .first(x: 1)
  .second(y: "ok")

// ───────────────────────────────────────────────────────────────
// 4. Nested calls com named args
// ───────────────────────────────────────────────────────────────

func wrap(value: string): string {
  return value
}

func outer(prefix: string, inner: string): string {
  return prefix + inner
}

val nested = outer(prefix: "[", inner: wrap(value: "hello"))

// ───────────────────────────────────────────────────────────────
// 5. Todas as ordens possíveis (same params, all named)
// ───────────────────────────────────────────────────────────────

func many(a: int, b: string, c: float): string {
  return b
}

val o1 = many(a: 1, b: "x", c: 3.0)
val o2 = many(c: 3.0, a: 1, b: "x")
val o3 = many(b: "x", c: 3.0, a: 1)
val o4 = many(a: 1, c: 3.0, b: "x")

// ───────────────────────────────────────────────────────────────
// 6. Mixed positional + named (varias combinações)
// ───────────────────────────────────────────────────────────────

func configure(host: string, port: int, debug: bool): string {
  return host
}

val m1 = configure("localhost", port: 8080, debug: true)
val m2 = configure("localhost", port: 443, debug: false)

// ───────────────────────────────────────────────────────────────
// 7. Named args with return type matching
// ───────────────────────────────────────────────────────────────

func makePoint(x: float, y: float): Vec2 {
  return Vec2 { x: x, y: y }
}

val pt: Vec2 = makePoint(x: 1.0, y: 2.0)

// ───────────────────────────────────────────────────────────────
// 8. Struct literal vs named call — desambiguação
// ───────────────────────────────────────────────────────────────

struct Config {
  host: string
  port: int
}

func buildConfig(host: string, port: int): Config {
  return Config { host: host, port: port }
}

val cfg1 = buildConfig(host: "localhost", port: 8080)
val cfg2 = Config { host: "localhost", port: 8080 }

// ───────────────────────────────────────────────────────────────
// 9. Named args with generic function type param
// ───────────────────────────────────────────────────────────────

func identity2<T>(value: T): T {
  return value
}

val id_a: int = identity2<int>(value: 99)
val id_b: string = identity2<string>(value: "named-generic")

// ───────────────────────────────────────────────────────────────
// 10. Named-only call with single param
// ───────────────────────────────────────────────────────────────

func greet(name: string): string {
  return name
}

val g: string = greet(name: "single-named")


