// struct-shorthand-err.med — Shorthand: expected errors
// ════════════════════════════════════════════════════════════════


struct User {
  name: string
  age: int
}

struct Point {
  x: float
  y: float
}


// ❌ ERRO 1: shorthand com campo inexistente + missing field
// UNKNOWN_PROPERTY: property 'unknownField' does not exist
// TYPE_MISMATCH: missing required field 'age'

func bad1(name: string): User {
  return User { name, unknownField }
}


