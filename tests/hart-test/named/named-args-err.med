func greet(name: string, age: int): string {
  return name
}

func many(a: int, b: string, c: float): string {
  return b
}


// ───────────────────────────────────────────────────────────────
// ❌ ERRO 1: unknown parameter name
// ════════════════════════════════════════════════════════════════
// UNKNOWN_PROPERTY: 'unknown parameter 'xyz''

// val err1 = greet(name: "ana", xyz: 1)


// ───────────────────────────────────────────────────────────────
// ❌ ERRO 2: type mismatch in named arg
// ════════════════════════════════════════════════════════════════
// TYPE_MISMATCH: argument 'age': expected 'int', got 'string'

// val err2 = greet(name: "ana", age: "not-a-number")


// ───────────────────────────────────────────────────────────────
// ❌ ERRO 3: type mismatch in positional arg (still works)
// ════════════════════════════════════════════════════════════════
// TYPE_MISMATCH: argument 1: expected 'string', got 'int'

// val err3 = greet(42, age: 30)


// ───────────────────────────────────────────────────────────────
// ❌ ERRO 4: type mismatch in named arg with generics
// ════════════════════════════════════════════════════════════════
// TYPE_MISMATCH: argument 'value': expected 'int', got 'string'

func identity2<T>(value: T): T {
  return value
}

// val err4 = identity2<int>(value: "should-be-int")


