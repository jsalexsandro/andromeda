// Test: default parameters in struct methods
struct Counter {
  mut value: int = 0

  mut func increment(step: int = 1): int {
    value = value + step
    return value
  }

  mut func setValue(v: int = 10): int {
    value = v
    return value
  }
}

val c = Counter()
print("Initial: " + c.increment())   // 1
print("After +5: " + c.increment(5)) // 6
print("Set default: " + c.setValue()) // 10
print("Set 42: " + c.setValue(42))   // 42