// ========================================
// Teste: Concatenação de Strings (casos válidos)
// ========================================

// CASE 1: string literal + string literal
var c1 = "hello" + "world"

// CASE 2: string var + string literal
val s1: string = "hello"
var c2 = s1 + "world"

// CASE 3: string literal + string var
var c3 = "hello" + s1

// CASE 4: string var + string var
val s2: string = "world"
var c4 = s1 + s2

// CASE 5: mesma variavel + ela mesma
var c5 = s1 + s1

// CASE 10: encadeamento: "a" + "b" + "c"
var c10 = "a" + "b" + "c"

// CASE 12: type alias string + string
typealias Str = string
val alias: Str = "hello"
var c12 = alias + "world"

// CASE 13: concat dentro de funcao
func greet(name: string): string {
  return "Hello, " + name
}

// CASE 14: multiplas concatenacoes
func fullName(first: string, last: string): string {
  return first + " " + last
}

// CASE 18: concat + assign
var c18 = s1
c18 = c18 + " - ok"