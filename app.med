struct User {
  mut email: string
  mut password: string

  init(e: string, p: string){
    self.email = e
    if (p.length < 8){
        print("Error")
    } 

    self.password = p
  } 
}

extend User {
    mut func getEmail(): string {
        return self.email
    }
    
    mut func getPassword(): string {
        return self.password
    }
}

const People = User("", "3rtryry5y")


