// ============================================================
// BLOCO J — EXPLOSÃO COMBINATÓRIA
// ============================================================

typealias J1 = int | string
typealias J2 = bool | float

typealias J3 = J1 | J2
typealias J4 = J3[]
typealias J5 = J4 | null
typealias J6 = J5 | ((J3) => J3)
typealias J7 = J6 | [J3, J3]
typealias J8 = J7 | J7[]
typealias J9 = J8 | J8[][]
typealias J10 = J9 | null

val j1: J10 = null
val j2: J10 = [1, "a", true]