protocol Mutating {
  mut func change(): void
}

protocol NonMutating {
  func read(): void
}

struct ImplMut {
  mut value: int = 0
  
  // Should work - mut protocol, mut implementation
  mut func change(): void {
    value = value + 1
  }
  
  func read(): void {
    // Should fail - trying to read from non-mut method but accessing mut field
    print(value)
  }
}

struct ImplNonMut {
  mut value: int = 0
  
  // Should fail - non-mut protocol but mut implementation (actually allowed?)
  func change(): void {
    value = value + 1
  }
}

struct ImplMixed {
  mut value: int = 0
  
  // Should work - mut protocol, mut implementation
  mut func change(): void {
    value = value + 1
  }
  
  mut func read(): void {
    // Should work - mut method
    print(value)
  }
}

val a = ImplMut { value: 10 }
a.change()
a.read()

val b = ImplNonMut { value: 20 }
b.change()

val c = ImplMixed { value: 30 }
c.change()
c.read()