// Test: typealias genérico

typealias Nullable<T> = T?

// Uso básico
val a: Nullable<int> = 1
val b: Nullable<string> = "hello"
val c: Nullable<int> = null

// Uso com inferência
func make<T>(x: T): Nullable<T> { return x }
val d: Nullable<int> = make(42)
val e: Nullable<string> = make("test")

// Aninhado com outro generic
val f: Nullable<Nullable<int>> = 42

// Em parâmetro de função
func process(x: Nullable<int>): int {
  if val v = x {
    return v
  }
  return 0
}

val g: int = process(10) 
val h: int = process(null)
