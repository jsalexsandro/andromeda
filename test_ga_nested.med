// Test: Aliases aninhados (alias que usa outro alias)
typealias Nullable<T> = T?
typealias MaybeArray<T> = Nullable<T>[]
typealias Wrapped<T> = Nullable<Nullable<T>>

// MaybeArray: T?[] — array de opcionais
val arr1: MaybeArray<int> = [1, null, 3]
val arr2: MaybeArray<string> = ["a", null, "c"]

// Wrapped: T?? — opcional duplo
val w1: Wrapped<int> = 42
val w2: Wrapped<int> = null

// Alias que referencia outro alias como parte da definição
typealias DeepNullable<T> = Nullable<Nullable<Nullable<T>>>
val deep1: DeepNullable<int> = 7
val deep2: DeepNullable<int> = null

// Alias que usa outro alias no parametro
typealias Pair<A, B> = [A, B]
typealias NullablePair<T, U> = Pair<Nullable<T>, Nullable<U>>

val np1: NullablePair<int, string> = [1, "a"]
val np2: NullablePair<int, string> = [null, null]
