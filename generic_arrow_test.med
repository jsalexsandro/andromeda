// ═══════════════════════════════════════════════════════════════
// Generic Arrow Functions — Test Suite
// ═══════════════════════════════════════════════════════════════

// ── 1. Basic generic arrow ───────────────────────────────────
val id1 = <T>(x: T): T => x
val r1: int = id1<int>(42)
val r2: string = id1<string>("hello")

// ── 2. Multiple type params ──────────────────────────────────
val pair = <A, B>(a: A, b: B): A => a
val r3: int = pair<int, string>(1, "hello")

// ── 3. Stored and called multiple times ──────────────────────
val id2 = <T>(x: T): T => x
val r4: int = id2(10)
val r5: string = id2("world")

// ── 4. With arrays ───────────────────────────────────────────
val first = <T>(arr: T[]): T => arr[0]
val r6: int = first<int>([1, 2, 3])
val r7: string = first<string>(["a", "b"])

// ── 5. Inside generic call (Bug #11 — fixed) ─────────────────
func apply<T>(x: T, fn: (T) => T): T { return fn(x) }
val r8 = apply(10, <T>(x: T): T => x)

// ── 6. Swap case — multiple type params in generic call ──────
func swap<A, B>(pair: (A, B) => B, a: A, b: B): B { return pair(a, b) }
val r9 = swap(<A, B>(a: A, b: B): B => b, 1, "hello")

// ── 7. Grouped generic arrow + immediate call ────────────────
val r10 = (<T>(x: T): T => x)(42)

// ── 8. Generic arrow with explicit type args in call ─────────
val id3 = <T>(x: T): T => x
val r11 = id3<int>(100)
val r12 = id3<string>("test")

// ── 9. Higher-order: arrow returning generic arrow ───────────
val nested = <T>(x: T): (T) => T => (y: T): T => y

// ── 10. Expression body generic arrow ────────────────────────
val triple = <T>(x: T): T => x
val r13: int = triple<int>(7)

// ═══════════════════════════════════════════════════════════════
// EXPECTED ERRORS
// ═══════════════════════════════════════════════════════════════

// ── E1. Cannot assign function type to int ───────────────────
val e1: int = <T>(x: T): T => x

// ═══════════════════════════════════════════════════════════════
// SEMANTIC EDGE CASES
// ═══════════════════════════════════════════════════════════════

// ── 11. Type param used in return and param different pos ────
val first_of_pair = <A, B>(a: A, b: B): A => a
val r14 = first_of_pair<int, string>(42, "hello")

// ── 12. Generic arrow with same name as outer type param ─────
func outer<T>(x: T): T {
  val local_id = <T>(x: T): T => x
  return local_id(x)
}
val r15 = outer(99)
