// divisao: int / int e inteiro na linguagem (truncado)

val a: int = 10
val b: int = 3

print(a / b)        // 3   (nao 3.333)
print(a / 4)        // 2
print(-10 / 3)      // -3  (trunca em direcao a zero, como Rust/Go)
print(a % b)        // 1
print(-10 % 3)      // -1
print(10 % 4)       // 2

// float continua float
val x: float = 10.0
print(x / 3)        // 3.3333333333333335
print(a / 3.0)      // 3.3333333333333335

// divisao em expressao e atribuicao
val total: int = 100
val count: int = 3
print(total / count)
val media: int = total / count
print(media)

// divisor variavel nunca e zero nos testes acima — o runtime protege
val safe: int = 2
print(a / safe)

// encadeamento com metodo
print(a % 3)

// float por zero segue IEEE de proposito
print(10.0 / 0.0)   // Infinity
print(-1.0 / 0.0)   // -Infinity