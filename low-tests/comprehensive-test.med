// ============================================================
// Comprehensive Transpiler Test - Algorithm Suite
// Uses ALL features implemented so far
// ============================================================

// Type aliases
typealias ID = int
typealias Score = float
typealias Name = string
typealias UserData = Name | int
typealias IntArray = int[]
typealias Matrix = int[][]
typealias OptionalScore = Score?

// ============================================================
// Utility Functions
// ============================================================

// Generic identity function
func identity<T>(x: T): T {
  return x
}

// Generic array processor
func mapArray<T, U>(arr: T[], fn: (T) => U): U[] {
  var result: U[] = []
  var i: int = 0
  while (i < arr.length) {
    result = result + [fn(arr[i])]
    i = i + 1
  }
  return result
}

// Generic filter
func filterArray<T>(arr: T[], predicate: (T) => bool): T[] {
  var result: T[] = []
  var i: int = 0
  while (i < arr.length) {
    if (predicate(arr[i])) {
      result = result + [arr[i]]
    }
    i = i + 1
  }
  return result
}

// Reduce/fold
func reduceArray<T, U>(arr: T[], initial: U, fn: (U, T) => U): U {
  var acc: U = initial
  var i: int = 0
  while (i < arr.length) {
    acc = fn(acc, arr[i])
    i = i + 1
  }
  return acc
}

// ============================================================
// Math/Statistics Functions
// ============================================================

func sum(arr: int[]): int {
  var total: int = 0
  var i: int = 0
  while (i < arr.length) {
    total = total + arr[i]
    i = i + 1
  }
  return total
}

func average(arr: int[]): float {
  if (arr.length == 0) {
    return 0.0
  }
  return sum(arr) / arr.length
}

func min(arr: int[]): int {
  var m: int = arr[0]
  var i: int = 1
  while (i < arr.length) {
    if (arr[i] < m) {
      m = arr[i]
    }
    i = i + 1
  }
  return m
}

func max(arr: int[]): int {
  var m: int = arr[0]
  var i: int = 1
  while (i < arr.length) {
    if (arr[i] > m) {
      m = arr[i]
    }
    i = i + 1
  }
  return m
}

func variance(arr: int[]): float {
  var avg: float = average(arr)
  var varSum: float = 0.0
  var i: int = 0
  while (i < arr.length) {
    var diff: float = arr[i] - avg
    varSum = varSum + (diff * diff)
    i = i + 1
  }
  return varSum / arr.length
}

func stdDev(arr: int[]): float {
  var v: float = variance(arr)
  return v.sqrt()
}

// ============================================================
// String Processing Functions
// ============================================================

func join(arr: string[], sep: string): string {
  if (arr.length == 0) {
    return ""
  }
  var result: string = arr[0]
  var i: int = 1
  while (i < arr.length) {
    result = result + sep + arr[i]
    i = i + 1
  }
  return result
}

func splitLines(text: string): string[] {
  // Simplified - returns array with the text
  return [text]
}

func toUpper(s: string): string {
  return s  // placeholder
}

func trim(s: string): string {
  return s  // placeholder
}

// ============================================================
// Data Structures
// ============================================================

struct Point {
  x: float
  y: float
  
  func distance(other: Point): float {
    var dx: float = self.x - other.x
    var dy: float = self.y - other.y
    return (dx * dx + dy * dy).sqrt()
  }
  
  func magnitude(): float {
    return (self.x * self.x + self.y * self.y).sqrt()
  }
  
  func add(other: Point): Point {
    return Point { x: self.x + other.x, y: self.y + other.y }
  }
}

struct Rectangle {
  topLeft: Point
  bottomRight: Point
  
  func width(): float {
    return self.bottomRight.x - self.topLeft.x
  }
  
  func height(): float {
    return self.bottomRight.y - self.topLeft.y
  }
  
  func area(): float {
    return self.width() * self.height()
  }
  
  func contains(p: Point): bool {
    return p.x >= self.topLeft.x && p.x <= self.bottomRight.x &&
           p.y >= self.topLeft.y && p.y <= self.bottomRight.y
  }
}

struct Student {
  id: ID
  name: Name
  scores: IntArray
  
  func average(): float {
    return average(self.scores)
  }
  
  func grade(): string {
    var avg: float = self.average()
    if (avg >= 90.0) {
      return "A"
    } else if (avg >= 80.0) {
      return "B"
    } else if (avg >= 70.0) {
      return "C"
    } else if (avg >= 60.0) {
      return "D"
    } else {
      return "F"
    }
  }
  
  func passed(): bool {
    return self.average() >= 60.0
  }
}

struct Statistics {
  count: int
  sum: int
  avg: float
  minVal: int
  maxVal: int
  variance: float
  
  func summary(): string {
    return "Count: " + count + ", Sum: " + sum + ", Avg: " + avg + 
           ", Min: " + minVal + ", Max: " + maxVal + ", Var: " + variance
  }
}

// ============================================================
// Algorithm: Process Student Data
// ============================================================

func processStudents(students: Student[]): Statistics {
  var count: int = students.length
  var allScores: int[] = []
  
  var i: int = 0
  while (i < students.length) {
    var studentScores: int[] = students[i].scores
    var j: int = 0
    while (j < studentScores.length) {
      allScores = allScores + [studentScores[j]]
      j = j + 1
    }
    i = i + 1
  }
  
  return Statistics {
    count: allScores.length,
    sum: sum(allScores),
    avg: average(allScores),
    minVal: min(allScores),
    maxVal: max(allScores),
    variance: variance(allScores)
  }
}

func findTopStudent(students: Student[]): Student? {
  if (students.length == 0) {
    return null
  }
  var top: Student = students[0]
  var i: int = 1
  while (i < students.length) {
    if (students[i].average() > top.average()) {
      top = students[i]
    }
    i = i + 1
  }
  return top
}

func filterPassed(students: Student[]): Student[] {
  var result: Student[] = []
  var i: int = 0
  while (i < students.length) {
    if (students[i].passed()) {
      result = result + [students[i]]
    }
    i = i + 1
  }
  return result
}

// ============================================================
// Algorithm: Geometric Operations
// ============================================================

func createGrid(rows: int, cols: int, spacing: float): Point[] {
  var points: Point[] = []
  var r: int = 0
  while (r < rows) {
    var c: int = 0
    while (c < cols) {
      points = points + [Point { x: c * spacing, y: r * spacing }]
      c = c + 1
    }
    r = r + 1
  }
  return points
}

func findPointsInRect(points: Point[], rect: Rectangle): Point[] {
  var result: Point[] = []
  var i: int = 0
  while (i < points.length) {
    if (rect.contains(points[i])) {
      result = result + [points[i]]
    }
    i = i + 1
  }
  return result
}

func closestPair(points: Point[]): Point[] {
  if (points.length < 2) {
    return points
  }
  var minDist: float = points[0].distance(points[1])
  var p1: Point = points[0]
  var p2: Point = points[1]
  
  var i: int = 0
  while (i < points.length) {
    var j: int = i + 1
    while (j < points.length) {
      var d: float = points[i].distance(points[j])
      if (d < minDist) {
        minDist = d
        p1 = points[i]
        p2 = points[j]
      }
      j = j + 1
    }
    i = i + 1
  }
  return [p1, p2]
}

// ============================================================
// Algorithm: Sorting (Bubble Sort for simplicity)
// ============================================================

func bubbleSort(arr: int[]): int[] {
  var a: int[] = arr
  var n: int = a.length
  var i: int = 0
  while (i < n - 1) {
    var j: int = 0
    while (j < n - i - 1) {
      if (a[j] > a[j + 1]) {
        var temp: int = a[j]
        a[j] = a[j + 1]
        a[j + 1] = temp
      }
      j = j + 1
    }
    i = i + 1
  }
  return a
}

func quickSelect(arr: int[], k: int): int {
  var sorted: int[] = bubbleSort(arr)
  return sorted[k]
}

// ============================================================
// Algorithm: Matrix Operations
// ============================================================

func transpose(matrix: Matrix): Matrix {
  if (matrix.length == 0) {
    return []
  }
  var rows: int = matrix.length
  var cols: int = matrix[0].length
  var result: Matrix = []
  var i: int = 0
  while (i < cols) {
    var row: int[] = []
    var j: int = 0
    while (j < rows) {
      row = row + [matrix[j][i]]
      j = j + 1
    }
    result = result + [row]
    i = i + 1
  }
  return result
}

func matrixMultiply(a: Matrix, b: Matrix): Matrix {
  var rowsA: int = a.length
  var colsA: int = a[0].length
  var colsB: int = b[0].length
  
  var result: Matrix = []
  var i: int = 0
  while (i < rowsA) {
    var row: int[] = []
    var j: int = 0
    while (j < colsB) {
      var sum: int = 0
      var k: int = 0
      while (k < colsA) {
        sum = sum + a[i][k] * b[k][j]
        k = k + 1
      }
      row = row + [sum]
      j = j + 1
    }
    result = result + [row]
    i = i + 1
  }
  return result
}

func matrixSum(matrix: Matrix): int {
  var total: int = 0
  var i: int = 0
  while (i < matrix.length) {
    var row: int[] = matrix[i]
    var j: int = 0
    while (j < row.length) {
      total = total + row[j]
      j = j + 1
    }
    i = i + 1
  }
  return total
}

// ============================================================
// Main Program
// ============================================================

// Sample data
val student1 = Student { 
  id: 1, 
  name: "Alice", 
  scores: [85, 92, 78, 96, 88] 
}

val student2 = Student { 
  id: 2, 
  name: "Bob", 
  scores: [72, 68, 75, 70, 74] 
}

val student3 = Student { 
  id: 3, 
  name: "Charlie", 
  scores: [95, 98, 93, 97, 94] 
}

val student4 = Student { 
  id: 4, 
  name: "Diana", 
  scores: [60, 65, 58, 62, 59] 
}

val student5 = Student { 
  id: 5, 
  name: "Eve", 
  scores: [88, 85, 90, 87, 89] 
}

val allStudents: Student[] = [student1, student2, student3, student4, student5]

// Process students
val stats = processStudents(allStudents)
val topStudent = findTopStudent(allStudents)
val passedStudents = filterPassed(allStudents)

// Display statistics
val statsSummary = stats.summary()

// Grade distribution
val gradeCounts: int[] = [0, 0, 0, 0, 0]  // A, B, C, D, F
var idx: int = 0
while (idx < allStudents.length) {
  var grade: string = allStudents[idx].grade()
  if (grade == "A") {
    gradeCounts[0] = gradeCounts[0] + 1
  } else if (grade == "B") {
    gradeCounts[1] = gradeCounts[1] + 1
  } else if (grade == "C") {
    gradeCounts[2] = gradeCounts[2] + 1
  } else if (grade == "D") {
    gradeCounts[3] = gradeCounts[3] + 1
  } else {
    gradeCounts[4] = gradeCounts[4] + 1
  }
  idx = idx + 1
}

// Geometric processing
val gridPoints = createGrid(5, 5, 10.0)
val searchRect = Rectangle { 
  topLeft: Point { x: 15.0, y: 15.0 }, 
  bottomRight: Point { x: 35.0, y: 35.0 } 
}
val inRect = findPointsInRect(gridPoints, searchRect)
val closest = closestPair(gridPoints)

// Matrix operations
val matA: Matrix = [[1, 2, 3], [4, 5, 6]]
val matB: Matrix = [[7, 8], [9, 10], [11, 12]]
val matC = matrixMultiply(matA, matB)
val matSum = matrixSum(matC)

// Arrow function demonstrations
val double = (x: int): int => x * 2
val square = (x: int): int => x * x
val isEven = (x: int): bool => x % 2 == 0
val toString = (x: int): string => x + ""

// Map with arrows
val doubledScores = mapArray<int, int>(student1.scores, double)
val squaredScores = mapArray<int, int>(student1.scores, square)

// Filter with arrows
val evenScores = filterArray<int>(student1.scores, isEven)

// Reduce with arrow
val totalScores = reduceArray<int, int>(student1.scores, 0, (acc: int, x: int): int => acc + x)

// Ternary and nullish coalescing
val hasTop = topStudent != null
val topName = hasTop ? (identity<string>("Top")) : "None"
val defaultScore: int? = null
val safeScore = defaultScore ?? 0

// Nested ternary
val performance = stats.avg >= 90.0 ? "Excellent" : 
                  stats.avg >= 75.0 ? "Good" : 
                  stats.avg >= 60.0 ? "Average" : "Needs Improvement"

// Complex expression statements
stats.count
stats.avg
passedStudents.length
inRect.length
closest[0].distance(closest[1])
matSum
doubledScores[0]
evenScores.length
totalScores

// Compound assignments
var counter: int = 0
counter += 1
counter += 1
counter *= 2
counter -= 1

var message: string = "Result: "
message += statsSummary
message += " | Top: " + topName
message += " | Passed: " + passedStudents.length
message += " | Grid: " + gridPoints.length
message += " | InRect: " + inRect.length
message += " | ClosestDist: " + closest[0].distance(closest[1])
message += " | MatSum: " + matSum

// Generic calls
val idInt = identity<int>(42)
val idStr = identity<string>("test")
val idFloat = identity<float>(3.14)

// Array with spread
val combined = [...student1.scores, ...student2.scores, 100, 200]
val combined2 = [...combined, ...student3.scores]

// Final expression statements (demonstrate everything works)
combined.length
combined2.length
message
performance
safeScore
idInt
idStr
idFloat