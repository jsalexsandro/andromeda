// Fase 2 - WhileStatement e ExpressionStatement

// WhileStatement
var i: int = 0
while (i < 5) {
  val squared = i * i
  i = i + 1
}

// While com break
var j: int = 0
while (true) {
  if (j >= 3) {
    break
  }
  j = j + 1
}

// While com continue
var k: int = 0
while (k < 5) {
  k = k + 1
  if (k == 3) {
    continue
  }
  val processed = k * 2
}

// ExpressionStatement (expr como statement - resultado ignorado)
func foo(): int { return 42 }
foo()  // chamada de função como statement

val x: int = 10
x + 5  // expressão como statement (sem efeito)

// Expressões complexas como statement
val a: int = 1
val b: int = 2
a + b * 3
!false
"hello"
42
null