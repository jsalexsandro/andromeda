// ============================================================
// GENERIC TYPEALIAS + CIRCULAR DETECTION TEST SUITE
// ============================================================



// ============================================================
// SECTION 1 — BASIC GENERIC TYPEALIAS
// ============================================================

typealias Box<T> = T

val a1: Box<int> = 42
val a2: Box<string> = "hello"



// ============================================================
// SECTION 2 — NULLABLE GENERIC ALIAS
// ============================================================

typealias Nullable<T> = T | null

val b1: Nullable<int> = 42
val b2: Nullable<int> = null

val b3: Nullable<string> = "hello"
val b4: Nullable<string> = null



// ============================================================
// SECTION 3 — ARRAY GENERIC ALIAS
// ============================================================

typealias List<T> = T[]

val c1: List<int> = [1, 2, 3]
val c2: List<string> = ["a", "b"]



// ============================================================
// SECTION 4 — NESTED GENERIC ALIAS
// ============================================================

typealias Matrix<T> = T[][]

val d1: Matrix<int> = [
  [1, 2],
  [3, 4]
]



// ============================================================
// SECTION 5 — MULTI TYPE PARAM ALIAS
// ============================================================

typealias Pair<A, B> = B

val e1: Pair<int, string> = "hello"
val e2: Pair<bool, int> = 42



// ============================================================
// SECTION 6 — ALIAS OF ALIAS
// ============================================================

typealias Id<T> = T
typealias UserId = Id<int>

val f1: UserId = 10



// ============================================================
// SECTION 7 — GENERIC FUNCTION + GENERIC ALIAS
// ============================================================

typealias Maybe<T> = T | null

func identity<T>(x: T): T {
  return x
}

val g1: Maybe<int> = identity<Maybe<int>>(42)
val g2: Maybe<int> = identity<Maybe<int>>(null)



// ============================================================
// SECTION 8 — GENERIC ARROW + GENERIC ALIAS
// ============================================================

typealias Boxed<T> = T[]

val wrap = <T>(x: T): Boxed<T> => [x]

val h1: Boxed<int> = wrap(42)
val h2: Boxed<string> = wrap("hello")



// ============================================================
// SECTION 9 — ALIAS NORMALIZATION
// ============================================================

typealias Numbers = int[]

func first<T>(arr: T[]): T {
  return arr[0]
}

val i1: int = first<Numbers>([
  [1, 2, 3]
])



// ============================================================
// SECTION 10 — GENERIC NULLABLE FLOW (built-in Optional)
// ============================================================

func unwrap<T>(x: Optional<T>): Optional<T> {

  if val value = x {
    return value
  }

  return null
}

val j1: Optional<int> = unwrap(42)
val j2: Optional<int> = unwrap(null)



// ============================================================
// SECTION 11 — DEEP ALIAS CHAIN
// ============================================================

typealias A<T> = T
typealias B<T> = A<T>
typealias C<T> = B<T>
typealias D<T> = C<T>

val k1: D<int> = 42
val k2: D<string> = "hello"



// ============================================================
// SECTION 12 — GENERIC FUNCTION USING ALIAS
// ============================================================

typealias ArrayBox<T> = T[]

func clone<T>(arr: ArrayBox<T>): ArrayBox<T> {
  return [...arr]
}

val l1: ArrayBox<int> = clone([1, 2, 3])



// ============================================================
// SECTION 13 — GENERIC CALLBACK + ALIAS
// ============================================================

typealias Callback<T> = () => T

func call<T>(fn: Callback<T>): T {
  return fn()
}

val m1: int = call<int>(
  (): int => 42
)



// ============================================================
// SECTION 14 — NESTED ALIAS GENERICS
// ============================================================

typealias NullableArray<T> = T[] | null

val n1: NullableArray<int> = [1, 2]
val n2: NullableArray<int> = null



// ============================================================
// SECTION 15 — BIDIRECTIONAL GENERIC ALIAS
// ============================================================

typealias Result<T> = T

func make<T>(): T {
  return make<T>()
}

val o1: Result<int> = make()
val o2: Result<string> = make()



// ============================================================
// SECTION 16 — GENERIC ARROW + ALIAS PROPAGATION
// ============================================================

typealias Fn<T> = (T) => T

val apply = <T>(
  value: T,
  fn: Fn<T>
): T => {
  return fn(value)
}

val p1: int = apply(
  10,
  (n: int): int => n + 1
)



// ============================================================
// SECTION 17 — ALIAS INSIDE ALIAS
// ============================================================

typealias Inner<T> = T[]
typealias Outer<T> = Inner<T>[]

val q1: Outer<int> = [
  [1, 2],
  [3, 4]
]



// ============================================================
// SECTION 18 — GENERIC ALIAS + HIGHER ORDER
// ============================================================

typealias Mapper<T, U> = (T) => U

func map<T, U>(
  x: T,
  fn: Mapper<T, U>
): U {
  return fn(x)
}

val r1: string = map(
  42,
  (n: int): string => "ok"
)



