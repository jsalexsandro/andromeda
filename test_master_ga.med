// ============================================================
// SECTION 26 — INVALID NORMALIZATION
// ============================================================

typealias NumList = int[]

func take(arr: int[]): int {
  return arr[0]
}

val u1: int = take([1, 2, 3])

val u2: int = take(
  [1, 2, 3]
)



// ============================================================
// SECTION 27 — THE FINAL GOD TEST
// ============================================================

typealias MaybeBox<T> = T[] | null

val final = <T>(
  value: T?,
  transform: ((T) => T)?,
  fallback: (() => T)?
): MaybeBox<T> => {

  if val v = value {

    if val fn = transform {

      val transformed = fn(v)

      return [transformed]
    }

  }

  if val fb = fallback {
    return [fb()]
  }

  return null
}

val z1: MaybeBox<int> = final(
  10,
  (n: int): int => n + 1,
  (): int => 0
)

val z2: MaybeBox<string> = final(
  null,
  (s: string): string => s + "!",
  (): string => "fallback"
)
