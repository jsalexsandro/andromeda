// ============================================================
// TEST 25 — NARROW WITH GENERIC FUNCTION RETURN
// ============================================================

func create<T>(x: T): T? {
  return x
}

func consume<T>(x: T?): T? {

  if val value = x {
    return create(value)
  }

  return null
}

val w1: int? = consume(42)



// ============================================================
// TEST 26 — IF VAR MUTATION FLOW
// ============================================================

func mutate<T>(x: T?): T? {

  if var value = x {

    value = value

    return value
  }

  return null
}

val x1: int? = mutate(42)



// ============================================================
// TEST 27 — FUNCTION FACTORY + NARROW
// ============================================================

func factory<T>(x: T): (() => T)? {

  return (): T => x
}

val y1 = factory(42)

if val fn = y1 {

  val y2: int = fn()

}



// ============================================================
// TEST 28 — COMPLEX CASCADE
// ============================================================

func cascade<T>(x: T?): T? {

  if val a = x {

    val b = id(a)

    return b
  }

  return null
}

val z1: int? = cascade(42)



// ============================================================
// TEST 29 — NESTED GENERIC CALLBACKS
// ============================================================

func nestedCall<T>(fn: (() => (() => T))?): T? {

  if val outer = fn {

    val inner = outer()

    return inner()
  }

  return null
}

val aa1: int? = nestedCall(
  (): (() => int) => {
    return (): int => 42
  }
)



// ============================================================
// TEST 30 — THE FINAL BOSS
// ============================================================

func final<T>(
  value: T?,
  transform: ((T) => T)?,
  fallback: (() => T)?
): T? {

  if val v = value {

    if val fn = transform {
      return fn(v)
    }

  }

  if val fb = fallback {
    return fb()
  }

  return null
}

val ab1: int? = final(
  10,
  (n: int): int => n + 1,
  (): int => 0
)

val ab2: string? = final(
  null,
  (s: string): string => s + "!",
  (): string => "fallback"
)

