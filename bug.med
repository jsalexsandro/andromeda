
struct Ship implements Stringable {
  mut name: string
  mut fuel: int
  mut credits: int

  init(name: string, fuel: int, credits: int) {
    self.name = name
    self.fuel = fuel
    self.credits = credits
  }

  func travel(distance: int): bool {
    if (self.fuel >= distance) {
      self.fuel = self.fuel - distance
      return true
    }

    return false
  }

  func toString(): string {
    return self.name
      + " | Fuel: " + self.fuel
      + " | Credits: " + self.credits
  }
}

extend Ship {
  func refuel(amount: int): bool {
    if (amount > 0 && self.credits >= amount) {
      self.credits = self.credits - amount
      self.fuel = self.fuel + amount
      return true
    }

    return false
  }
}

val ship = Ship("Odyssey", 100, 50)

print(ship)
print(ship.travel(30))
print(ship.refuel(20))
print(ship)
print(ship.travel(200))
print(ship)
