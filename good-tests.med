// ============================================================
// BLOCO U — PROTOCOLOS (smoke test)
// ============================================================

protocol Printable {
  func print(): void
}

protocol Comparable {
  func compare(other: int): int
}


// ============================================================
// BLOCO V — COMBINAÇÕES MÁXIMAS
// (casos que combinam múltiplas features ao mesmo tempo)
// ============================================================

typealias Score = int
typealias ScoreList = Score[]
typealias Scorer = (ScoreList) => Score

// [PASS] pipeline completo: typealias → array → função → índice
func v_best(scores: ScoreList): Score {
  return scores[0]
}

val v_data: ScoreList = [95, 87, 100, 76]
val v_r1: Score = v_best(v_data)

// [PASS] função de ordem superior com alias
func v_apply(scorer: Scorer, data: ScoreList): Score {
  return scorer(data)
}

val v_r2 = v_apply((s: ScoreList): Score => s[0], v_data)

// [PASS] spread + alias + rest
func v_merge(...lists: ScoreList[]): ScoreList {
  return [0]
}

val v_l1: ScoreList = [1, 2, 3]
val v_l2: ScoreList = [4, 5, 6]
val v_r3 = v_merge(v_l1, v_l2)
val v_r4 = v_merge(...[v_l1, v_l2])

// [PASS] nullable array + alias + índice + fallback
var v_maybe: ScoreList? = null
val v_r5: Score = v_maybe ?? [0]

// [PASS] arrays de nullable alias
val v_scores_opt: Score?[] = [100, null, 87]
val v_top: Score? = v_scores_opt[0]

