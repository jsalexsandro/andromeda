// ============================================================
// BLOCO O — SCOPING E SHADOWING
// ============================================================

val o_outer: int = 10

{
  // [PASS] bloco aninhado pode ler outer
  val o_inner: int = o_outer + 5
}

// [PASS] variável de loop isolada
for (var o_i: int = 0; o_i < 3; o_i++) {
  val o_inside = o_i
}

// [PASS] var pode ser redeclarada em escopo diferente
func o_fn(): int {
  val o_outer: int = 999   // shadow do outer global — válido em escopo diferente
  return o_outer
}

// [ERROR ZONE]
// val o_dup: int = 1
// val o_dup: int = 2         // [ERROR] já declarada no mesmo escopo
// o_i = 99                   // [ERROR] o_i não existe fora do for


// ============================================================
// BLOCO P — CONTROLE DE FLUXO + TIPOS
// ============================================================

// [PASS] if com bool
func p_abs(n: int): int {
  if (n < 0) {
    return 0 - n
  }
  return n
}

// [PASS] while com bool
func p_countdown(n: int): int {
  var p_x: int = n
  while (p_x > 0) {
    p_x -= 1
  }
  return p_x
}

// [PASS] for padrão
func p_sum(arr: int[]): int {
  var total: int = 0
  for (var p_i: int = 0; p_i < 10; p_i++) {
    total += 1
  }
  return total
}

// [PASS] ternário
val p_max: int = 10 > 5 ? 10 : 5

// [PASS] nullish coalescing
var p_maybe: int? = null
val p_val: int = p_maybe ?? 0

// [ERROR ZONE]
// if (1) { }                 // [ERROR] condição não é bool
// while ("true") { }         // [ERROR] condição não é bool
// func p_bad(): int { }      // [ERROR] falta return em não-void


