// [PASS] inferência aninhada: array de arrays inferido
val t9 = [[1, 2], [3, 4]]

// [PASS] float array inferido
val t10 = [1.5, 2.5, 3.5]

// [PASS] string array inferido
val t11 = ["alpha", "beta", "gamma"]

