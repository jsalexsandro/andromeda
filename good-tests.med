// ============================================================
// BLOCO S — BREAK E CONTINUE
// ============================================================

// [PASS] break em while
func s1(): int {
  var s_x: int = 0
  while (true) {
    s_x += 1
    if (s_x > 5) {
      break
    }
  }
  return s_x
}

// [PASS] continue em for
func s2(): int {
  var total: int = 0
  for (var s_i: int = 0; s_i < 10; s_i++) {
    if (s_i == 5) {
      continue
    }
    total += s_i
  }
  return total
}

// [ERROR ZONE]
// break                       // [ERROR] break fora de loop
// continue                    // [ERROR] continue fora de loop


