// BLOCO T — CASOS EXTREMOS DE INFERÊNCIA
// ============================================================

// [PASS] inferência em cadeia
val t1 = 1
val t2 = t1 + 2

// [PASS] inferência de função via uso
func t_add(a: int, b: int): int {
  return a + b
}

val t3 = t_add(1, 2)
val t4 = t_add(t1, t3)

// [PASS] inferência de 2D a partir de 1D reutilizado
val t5: int[] = [1, 2, 3]
val t6: int[][] = [t5, t5, t5]

// [PASS] spread de inferido em anotado
var t7 = [10, 20]
