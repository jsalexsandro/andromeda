// ============================================================
// TEST 20 — HIGHER ORDER GENERIC CASCADE
// ============================================================

func compose<A, B, C>(
  f: (B) => C,
  g: (A) => B,
  x: A
): C {
  return f(g(x))
}

func toInt(s: string): int {
  return 42
}

func plus(n: int): int {
  return n + 1
}

val t1: int = compose(
  plus,
  toInt,
  "hello"
)



