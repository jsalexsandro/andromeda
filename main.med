func make<T>(): T {
  return make<T>()
}

func consume(x: int): int {
  return x
}

val b1 = consume(make())



// ============================================================
// TEST 3 — GENERIC FUNCTION RETURNING FUNCTION
// ============================================================

func factory<T>(x: T): () => T {
  return (): T => x
}

val c1: () => int = factory(42)
val c2: int = c1()

val c3: () => string = factory("hello")
val c4: string = c3()



