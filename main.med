// ============================================================
// TEST 1 — GENERIC CHAIN PROPAGATION
// ============================================================

func id<T>(x: T): T {
  return x
}

func wrap<T>(x: T): T[] {
  return [x]
}

func unwrap<T>(x: T[]): T {
  return x[0]
}

val a1: int = unwrap(wrap(id(42)))
val a2: string = unwrap(wrap(id("hello")))



