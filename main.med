// ============================================================
// TEST 6 — GENERIC + NULLABLE + ARRAY + FUNCTION
// ============================================================

func nullableCall<T>(fn: (() => T)?): T? {
  if val f = fn {
    return f()
  }
  return null
}

val f1: int? = nullableCall((): int => 42)
val f2: string? = nullableCall((): string => "ok")
val f3: int? = nullableCall(null)



// ============================================================
// TEST 7 — GENERIC CALLBACK PROPAGATION
// ============================================================

func map<T, U>(x: T, fn: (T) => U): U {
  return fn(x)
}

val g1: string = map(42, (n: int): string => "num")
val g2: int = map("hello", (s: string): int => 1)



// ============================================================
// TEST 8 — GENERIC INSIDE GENERIC INSIDE GENERIC
// ============================================================

func outer<T>(x: T): T {

  func middle<U>(y: U): U {

    func inner<V>(z: V): V {
      return z
    }

    return inner(y)
  }

  return middle(x)
}

val h1: int = outer(42)
val h2: string = outer("hello")



// ============================================================
// TEST 9 — GENERIC SHADOWING HELL
// ============================================================

func x<T>(a: T): T {

  func y<T>(b: T): T {

    func z<T>(c: T): T {
      return c
    }

    return z(b)
  }

  return y(a)
}

val i1: int = x(42)



