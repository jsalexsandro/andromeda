var s = ['James', 1] // error arrays devem ser de um tipo predominante, exigir tipo unico no vetor sempre
s[0] = 1

// var y: (string | int)[] = ["James", 32] 
// “um array onde cada elemento pode ser string OU int” 
// isso ta estranho pois ta dinamico
// Isso permite:
// ["James", 32, "", 999, "abc", 0]
// ou seja:
// o array vira um “balde de valores heterogêneos”
// você perde significado estrutural

var tup: [string, int] = ['James', 22] // isso é uma tupla mas o inference ta detectando '(string | int)[]' na atribuição
